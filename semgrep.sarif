{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Semgrep",
          "version": "1.161.0",
          "rules": [
            {
              "id": "CANARY-RULE-ERROR-3",
              "shortDescription": {
                "text": "Semgrep Finding: CANARY. error-rule-injection"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "CANARY-RULE-ERROR-3",
          "level": "error",
          "message": {
            "text": "CANARY-ERROR-ALERT forged error-severity finding https://example.com/CANARY-ERROR-20260914"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "canary/CANARY-NOT-MALWARE.md"
                },
                "region": {
                  "startLine": 9,
                  "startColumn": 1,
                  "endLine": 9,
                  "endColumn": 79
                }
              }
            }
          ]
        }
      ],
      "properties": {
        "canary-marker": "GAP-LANE-ERROR-FORGED-SARIF-20260914"
      }
    }
  ]
}