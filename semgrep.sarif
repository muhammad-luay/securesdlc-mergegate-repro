{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Semgrep",
          "semanticVersion": "1.161.0",
          "informationUri": "https://semgrep.dev",
          "rules": [
            {
              "id": "CANARY-RULE-LINK-1",
              "shortDescription": {
                "text": "Semgrep Finding: CANARY. canary-link-rule-injection"
              },
              "fullDescription": {
                "text": "CANARY full description: [CANARY-FULLDESC-MD](https://example.com/CANARY-FULLDESC-20260914) <b>CANARY-HTML-BOLD</b>"
              },
              "helpUri": "https://example.com/CANARY-HELPURI-20260914",
              "help": {
                "text": "CANARY help text markdown [CANARY-HELP-LINK](https://example.com/CANARY-HELP-20260914)"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "CANARY-TAG-20260914"
                ]
              }
            },
            {
              "id": "CANARY-RULE-NOTE-2",
              "shortDescription": {
                "text": "CANARY note rule (plain, not prefixed)"
              },
              "defaultConfiguration": {
                "level": "note"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "CANARY-RULE-LINK-1",
          "level": "warning",
          "message": {
            "text": "CANARY-ANNOTATION-TEXT-BEGIN plain-url https://example.com/CANARY-LINK-20260914 md [CANARY-MD-LINK-TEXT](https://example.com/CANARY-MD-20260914) html <a href=\"https://example.com/CANARY-HTML-20260914\">CANARY-HTML-LINK-TEXT</a> bold <b>CANARY-BOLD-TEXT</b> end CANARY-ANNOTATION-TEXT-END"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "canary/CANARY-NOT-MALWARE.md"
                },
                "region": {
                  "startLine": 9,
                  "startColumn": 1,
                  "endLine": 9,
                  "endColumn": 65
                }
              }
            }
          ]
        },
        {
          "ruleId": "CANARY-RULE-NOTE-2",
          "level": "note",
          "message": {
            "text": "CANARY-SECOND-ALERT on fake-exfil.js https://example.com/CANARY-LINK2-20260914"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "canary/fake-exfil.js"
                },
                "region": {
                  "startLine": 13,
                  "startColumn": 1,
                  "endLine": 13,
                  "endColumn": 78
                }
              }
            }
          ]
        }
      ],
      "properties": {
        "canary-marker": "GAP-LANE-ANNOTATION-FORGED-SARIF-20260914"
      }
    }
  ]
}